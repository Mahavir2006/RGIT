# Urban Sentinel - example environment.
# Copy to `.env` and fill in only what you have. PLACEHOLDERS ONLY - never put real values here.
# Every provider connector falls back to clearly-labelled replay mode when its key is absent.

# ---------------------------------------------------------------- core
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE_DISPLAY=Asia/Kolkata
CORS_ORIGINS=
MAX_PAYLOAD_BYTES=262144

# ------------------------------------------------------------ database
# PostgreSQL (preferred). Leave unset to fall back to a local SQLite file (./urban_sentinel.db).
# DATABASE_URL=postgresql+asyncpg://urban_sentinel:<password>@127.0.0.1:5432/urban_sentinel
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------- auth
# Mutating endpoints (ingest, submit events/reports) require header `X-API-Key: <API_WRITE_KEY>`.
AUTH_ENABLED=true
API_WRITE_KEY=<generate-a-long-random-string>
API_READ_KEY=

# ------------------------------------------------------- http client
HTTP_TIMEOUT_SECONDS=20.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=8.0

# ------------------------------------------------- weather (OpenWeather)
OPENWEATHER_API_KEY=
WEATHER_LAT=19.0760
WEATHER_LON=72.8777
WEATHER_LOCATION_NAME=Mumbai

# --------------------------------------------- air quality (OpenAQ v3)
OPENAQ_API_KEY=
AQ_LAT=19.0760
AQ_LON=72.8777
AQ_RADIUS_M=25000
AQ_STATION_ID=
AQ_POLLUTANTS=pm25,pm10,no2,o3
AQ_PAGE_LIMIT=2

# ---------------------------------------------------- traffic (TomTom)
TOMTOM_API_KEY=
TRAFFIC_LAT=19.0760
TRAFFIC_LON=72.8777
TRAFFIC_SEGMENT_IDS=

# --------------------------------------------------------- water levels
# No live water-level API is configured. The adapter reads a CSV/JSON dataset via a mapping file.
WATER_PROVIDER=dataset
WATER_API_KEY=
WATER_BASE_URL=
WATER_DATASET_PATH=./data/samples/water_levels.csv
WATER_MAPPING_PATH=
WATER_EXPECTED_UNIT=m

# --------------------------------------------------- replay / scheduler
REPLAY_FIXTURES_DIR=./data/samples
REPLAY_SHUFFLE_SEED=1337
REPLAY_REBASE_TO_NOW=true
# Off by default so a local run never silently consumes a paid API quota.
SCHEDULER_ENABLED=false
SCHEDULER_SOURCES=replay
SCHEDULER_INTERVAL_SECONDS=300

# ------------------------------------------------- deterministic processing
# Validate, dedupe, detect anomalies and match candidates right after each ingestion run.
PROCESSING_AUTO_ON_INGEST=true
# Optional JSON file overriding thresholds/weights/windows (see app/processing/config.py).
PROCESSING_CONFIG_PATH=

# ------------------------------------------- intelligence layer wiring
# Mount urban_sentinel/ (multi-agent layer) into this app.
INTELLIGENCE_ENABLED=true
# Queue an agent analysis for every incident touched by processing. Off by default: LLM cost.
INTELLIGENCE_AUTO_TRIGGER=false

# ------------------------------------------------------------ freshness
DEFAULT_FRESHNESS_SLA_SECONDS=900
# Per-source override, e.g. weather.live=1800,airquality.live=3600,water.dataset=86400
FRESHNESS_SLA_SECONDS=

# ======================================================================
# Multi-agent intelligence layer (urban_sentinel/) - separate FastAPI app
# ======================================================================
# --- Application ---
URBAN_SENTINEL_ENV=development
URBAN_SENTINEL_LOG_LEVEL=INFO
URBAN_SENTINEL_API_HOST=0.0.0.0
URBAN_SENTINEL_API_PORT=8000

# Bearer token required for POST /api/v1/incidents/{id}/review
URBAN_SENTINEL_REVIEW_TOKEN=change-me
# Durable report lifecycle database. Mount this path on persistent storage in deployments.
URBAN_SENTINEL_REPORT_STORE_PATH=urban_sentinel_reports.sqlite3
# JSON mapping department IDs to HTTPS webhook URLs; example: {"drainage":"https://..."}
URBAN_SENTINEL_DEPARTMENT_WEBHOOKS={}
# Optional JSON maps: department ID -> webhook bearer credential / callback bearer credential.
URBAN_SENTINEL_DEPARTMENT_WEBHOOK_TOKENS={}
URBAN_SENTINEL_DEPARTMENT_UPDATE_TOKENS={}
# Publicly reachable API origin used to include callback URLs in webhook payloads.
URBAN_SENTINEL_PUBLIC_API_BASE_URL=
# Optional console origin; submission responses then include a shareable /track-report URL.
URBAN_SENTINEL_PUBLIC_WEB_BASE_URL=

# --- LLM (optional; deterministic fallback is used when unset/unavailable) ---
URBAN_SENTINEL_LLM_PROVIDER=none
# URBAN_SENTINEL_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# URBAN_SENTINEL_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
URBAN_SENTINEL_LLM_TIMEOUT_SECONDS=20
URBAN_SENTINEL_LLM_MAX_RETRIES=2
URBAN_SENTINEL_PROMPT_VERSION=intelligence-v1

# --- Neo4j (optional; in-memory graph used when unset; degraded mode if unreachable) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# --- Workflow bounds ---
URBAN_SENTINEL_MAX_GRAPH_DEPTH=4
URBAN_SENTINEL_ASSOCIATION_AMBIGUITY_THRESHOLD=0.65
URBAN_SENTINEL_HIGH_IMPACT_SEVERITY=0.75
URBAN_SENTINEL_CACHE_TTL_SECONDS=300
URBAN_SENTINEL_WORKFLOW_TIMEOUT_SECONDS=90

